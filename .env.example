# A/L Insight Bot Configuration
# Copy this file to .env and fill in your values

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# AI provider: "scraper" (gemini.google.com free) | "shyracore" (custom API) | "gemini" (SDK)
AI_PROVIDER=scraper

# Custom AI API (used for chat if AI_PROVIDER=shyracore)
AI_API_URL=https://shyracore.indevs.in/api/ai/shitsu
AI_API_KEY=your_api_key_here

# Bot Configuration
BOT_NAME=A/L Insight Bot
OWNER_NUMBER=94764642432

# Pairing code (set to your WhatsApp number to use phone pairing instead of QR)
# PHONE_NUMBER=94764642432

# Conversation Settings
MAX_HISTORY=10
TEMP_DIR=./tmp
DOWNLOAD_TIMEOUT=30000
MAX_FILE_SIZE=20971520

# Session Directory
SESSION_DIR=sessions